<!DOCTYPE html>
<html lang="en">

<head>
<%- include("partials/head", { title: title, mapPage: true }) %>
</head>

<body>
<%- include("partials/nav", { active: "explore" }) %>

    <div class="page" id="top">
        <header class="masthead">
            <div class="masthead-text">
                <h1>Reported ability to speak Irish</h1>
                <p class="lead">
                    Percentage of people aged 3 and over who reported that they
                    could speak Irish. This measures self-reported ability, not
                    fluency or regular use.
                </p>
            </div>
        </header>

        <div class="controls-row">
            <div class="toolbar-group">
                <button id="play-button" type="button" aria-pressed="false">
                    <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    Play animation
                </button>

                <label for="year-select">Census year</label>
                <select id="year-select">
                  <% abilityYears.forEach((year) => { %>
                    <option
                      value="<%= year %>"
                      <%= year === defaultYear ? "selected" : "" %>
                    >
                      <%= year %>
                    </option>
                  <% }); %>
                </select>
            </div>
        </div>

        <div class="explorer">
            <div class="map-panel">
                <div id="map"></div>
                <div class="map-caption">
                    <div id="legend" class="map-legend"></div>
                    <div class="map-hint">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
                        <span>Hover or tap a county to see details</span>
                    </div>
                </div>
            </div>

            <aside class="sidebar">
                <section id="county-panel" class="card county-panel" hidden>
                    <button id="county-panel-close" class="county-panel-close" type="button" aria-label="Close">&times;</button>
                    <div id="county-panel-body"></div>
                </section>

                <section class="card">
                    <h2>
                        <svg class="card-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg>
                        Insights
                    </h2>
                    <p id="insight-text" class="insight-text"></p>
                </section>

                <section class="card">
                    <h2>
                        <svg class="card-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4v11H4zm6-5h4v16h-4zm6 8h4v8h-4z"/></svg>
                        Summary
                    </h2>
                    <ul class="summary-list">
                        <li>
                            <span class="summary-label">Highest</span>
                            <span class="summary-figure"><i class="dot" id="sum-hi-dot"></i><span id="sum-hi-val">&ndash;</span></span>
                            <span class="summary-place" id="sum-hi-name"></span>
                        </li>
                        <li>
                            <span class="summary-label">Lowest</span>
                            <span class="summary-figure"><i class="dot" id="sum-lo-dot"></i><span id="sum-lo-val">&ndash;</span></span>
                            <span class="summary-place" id="sum-lo-name"></span>
                        </li>
                        <li>
                            <span class="summary-label">County average</span>
                            <span class="summary-figure"><span id="sum-avg-val">&ndash;</span></span>
                        </li>
                    </ul>
                </section>
            </aside>
        </div>

        <p class="page-hint">
            New here? Read <a href="about.html">about this project</a> or the
            <a href="methodology.html">methodology and data notes</a>.
        </p>

<%- include("partials/footer") %>
    </div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="js/map.js"></script>
<script src="js/nav.js"></script>

</body>

</html>
