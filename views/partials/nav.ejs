<% var active = (typeof active !== "undefined") ? active : ""; %>
<nav class="topnav">
    <div class="topnav-inner">
        <a class="brand" href="index.html">
            <img class="brand-logo" src="logo.png" width="768" height="768" alt="">
            <%# Name on two lines with the proverb under it, set off from the logo
                by a thin rule. %>
            <span class="brand-text">
                <span class="brand-name"><span>Irish</span> <span>language map</span></span>
                <span class="brand-tagline" lang="ga">Tír gan teanga, tír gan anam.</span>
            </span>
        </a>

        <%# Phones: a "Menu" pill that opens the links as a full page. Its three
