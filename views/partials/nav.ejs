        <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
            <span class="toggle-open">Menu</span>
            <span class="toggle-close">Close</span>
            <span class="toggle-icon" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>

        <div class="nav-links" id="nav-links">
            <a href="index.html" class="<%= active === 'explore' ? 'active' : '' %>">
                <img class="nav-spot" src="img/island.svg" alt="">
                <span class="nav-label">Explore Data</span>
            </a>
            <a href="about.html" class="<%= active === 'about' ? 'active' : '' %>">
                <img class="nav-spot" src="img/spot-speaker.svg" alt="">
                <span class="nav-label">About</span>
            </a>
            <a href="methodology.html" class="<%= active === 'methodology' ? 'active' : '' %>">
                <img class="nav-spot" src="img/spot-decline.svg" alt="">
                <span class="nav-label">Methodology</span>
            </a>
            <p class="nav-proverb" lang="ga">Tír gan teanga, tír gan anam.</p>
        </div>
    </div>
</nav>
