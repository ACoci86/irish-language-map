<% var ogTitle = (typeof ogTitle !== "undefined") ? ogTitle : title; %>
<% var isMap = (typeof mapPage !== "undefined" && mapPage); %>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%# Everything the page needs is served from this site (css/fonts.css has the
    two handwriting faces; vendor/ the libraries), so a blocked or slow third-
    party server can't break it. %>
<link rel="stylesheet" href="css/fonts.css?v=<%= assetVersion %>">
<link rel="preload" href="fonts/gaegu-700-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="fonts/patrick-hand-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<% if (isMap) { %>
<link rel="stylesheet" href="vendor/leaflet/leaflet.css">
<% } %>
<%# ?v= changes with every build, so browsers fetch the current files. %>
<link rel="stylesheet" href="css/style.css?v=<%= assetVersion %>">
<link rel="icon" type="image/png" href="favicon.png?v=4">
<link rel="apple-touch-icon" href="favicon.png?v=4">

<title><%= title %></title>

<meta name="description" content="<%= description %>">
<link rel="canonical" href="<%= canonical %>">

<!-- Open Graph / Twitter, so shared links render a preview card. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Irish language map">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="https://irishlanguagemap.org/social-preview.jpg">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt"
    content="Hand-drawn maps of Ireland in 1851 and 2022, beside the title: Where did the Irish language go?">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://irishlanguagemap.org/social-preview.jpg">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Irish language map",
  "url": "https://irishlanguagemap.org/"
}
</script>
<% if (isMap) { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Reported ability to speak Irish by county, 1851 to 2022",
  "description": "Percentage of people aged 3 and over who reported being able to speak Irish in each of Ireland's 32 counties, for every census from 1851 to 2022.",
  "url": "https://irishlanguagemap.org/",
  "creator": { "@type": "Person", "name": "Alessio Coci" },
  "license": "https://opensource.org/licenses/MIT",
  "keywords": ["Irish language", "Gaeilge", "census", "Ireland", "choropleth", "language decline"],
  "spatialCoverage": "Ireland",
  "temporalCoverage": "1851/2022",
  "isAccessibleForFree": true
}
</script>
<% } %>
